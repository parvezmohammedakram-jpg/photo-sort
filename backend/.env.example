# Server
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite:///./data/photosort.db

# Analysis Thresholds - Blur
BLUR_SHARP_THRESHOLD=100.0
BLUR_BORDERLINE_THRESHOLD=50.0

# Analysis Thresholds - Resolution
MIN_WIDTH=1280
MIN_HEIGHT=720
MIN_MEGAPIXELS=1.0

# Analysis Thresholds - Exposure
EXPOSURE_LOW_BRIGHTNESS=60
EXPOSURE_HIGH_BRIGHTNESS=200
DARK_PIXEL_THRESHOLD=30
BRIGHT_PIXEL_THRESHOLD=225
DARK_PIXEL_PCT_THRESHOLD=40.0
BRIGHT_PIXEL_PCT_THRESHOLD=40.0

# Analysis Thresholds - Face
FACE_DETECTION_CONFIDENCE=0.5
EYE_CLOSED_THRESHOLD=0.18

# Analysis Thresholds - Duplicate
DUPLICATE_HASH_THRESHOLD=10
DUPLICATE_HASH_SIZE=16

# Scoring Weights (must sum to 1.0)
WEIGHT_SHARPNESS=0.35
WEIGHT_RESOLUTION=0.10
WEIGHT_EXPOSURE=0.30
WEIGHT_FACE=0.25

# Category Thresholds
GOOD_THRESHOLD=70.0
REVIEW_THRESHOLD=40.0
DUPLICATE_PENALTY=10.0

# Processing
MAX_ANALYSIS_DIMENSION=2048
THUMBNAIL_SIZE=300
PREVIEW_SIZE=1200

# Supported Formats
SUPPORTED_EXTENSIONS=.jpg,.jpeg,.png,.webp

# Logging
LOG_LEVEL=INFO
